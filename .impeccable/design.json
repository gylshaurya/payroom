  "narrative": {
    "northStar": "Broadcast running order",
    "overview": "Deep indigo framing, cool white working sheets and compact rows give Payroom the character of an operator's desk. The selected request and its exact terms share a visual context with the receipt. Manrope carries both labels and amounts; alignment and explicit status text do the organizational work.\n\nCandidate 7, seed 0544fe78, composition A is implemented. Local execution disclosures remain visible; the design verdict does not establish live sponsor execution.",
    "keyCharacteristics": [
      "Indigo navigation framing a light working surface.",
      "Compact rows with a selected-item inspector.",
      "Flat sheets, fine separators and small corner radii.",
      "Explicit status labels and wrapping receipt metadata."
    ],
    "rules": [
      {
        "name": "The Separate Signals Rule",
        "body": "Selection identifies the reviewed invoice; a labelled badge identifies its state.",
        "section": "colors"
      },
      {
        "name": "The Exact Amount Rule",
        "body": "Preserve tabular alignment, visible currency and wrapping receipt values.",
        "section": "typography"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Separate content with borders and tonal changes rather than floating shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain explicit state labels.",
      "Do preserve phone gutters and final phone text sizes.",
      "Do keep local execution disclosures visible.",
      "Do respect keyboard focus and reduced motion."
    ],
    "donts": [
      "Do not convert the invoice desk into balance tiles.",
      "Do not add floating card shadows.",
      "Do not make long receipt values inaccessible through truncation."
    ]
  }
