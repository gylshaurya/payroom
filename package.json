{
  "name": "payroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/runtime.mjs start",
    "stop": "node scripts/runtime.mjs stop",
    "build": "forge build",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:contracts": "forge test -vv",
    "dev": "node src/server.mjs",
    "build:public": "node scripts/build-public.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "@safe-global/safe-contracts": "1.4.1",
    "esbuild": "0.28.2"
  }
}
